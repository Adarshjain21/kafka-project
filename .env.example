# Neon connection strings — get them from https://console.neon.tech
#
# Prisma convention:
#   DATABASE_URL  = pooled endpoint, used by Prisma Client for all queries.
#                   Hostname contains "-pooler".
#   DIRECT_URL    = direct endpoint, used by `prisma migrate` AND by the raw-pg
#                   LISTEN client in db.js. Hostname does NOT contain "-pooler".
#
# LISTEN/NOTIFY does NOT work through the Neon pooler (PgBouncer in transaction
# mode), which is why the LISTEN side needs the direct URL.
#
# Example:
#   DATABASE_URL=postgres://USER:PASS@ep-xxxxx-pooler.us-east-2.aws.neon.tech/DB?sslmode=require
#   DIRECT_URL=postgres://USER:PASS@ep-xxxxx.us-east-2.aws.neon.tech/DB?sslmode=require
#
DATABASE_URL=
DIRECT_URL=

# UI server port (default 3000)
PORT=3000

# Redis — hot cache for dedup, rider state, latest-N feed, rate limit, pub/sub.
# docker-compose exposes it on localhost:6379.
REDIS_URL=redis://localhost:6379

# How many rows the Redis sorted-set feed holds (consumer trims to this).
REDIS_FEED_MAX=100
# TTL (seconds) on the per-message dedup key. 24h is enough to absorb any
# realistic Kafka redelivery storm. The DB unique index still backstops.
REDIS_DEDUP_TTL=86400
# TTL (seconds) on per-rider state hashes. 7 days = GC inactive riders.
REDIS_STATE_TTL=604800

# Rate limit on POST /api/send — fixed window per client IP.
RATE_LIMIT=20
RATE_WINDOW_SEC=10
